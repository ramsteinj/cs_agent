# Copy to backend/.env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Trusted reverse proxies in front of Django (1 behind Nginx). 0 ignores X-Forwarded-For.
DJANGO_NUM_PROXIES=0
# Production only (DJANGO_DEBUG=False): see README "운영 배포 참고"
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Local PostgreSQL 18 (see specs/08-dev-and-testing.md)
DATABASE_URL=postgres://cs_agent:cs_agent@localhost:5432/cs_agent

# Required: Fernet key for API Key encryption. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Embeddings. The model and all RAG tuning values are set in the admin UI (stored in the DB).
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_DIM=384
# Load the embedding model in the background at server start (first question stays fast)
EMBEDDING_PRELOAD=True
