# Copy to backend/.env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Port must match the DB host port (root .env POSTGRES_PORT, default 5432)
DATABASE_URL=postgres://cs_agent:cs_agent@localhost:5432/cs_agent

# Required from Phase 3 (Fernet key for API Key encryption)
FIELD_ENCRYPTION_KEY=

# Used from Phase 4 (RAG)
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.6
