# Copy to backend/.env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local PostgreSQL 18 (see specs/08-dev-and-testing.md)
DATABASE_URL=postgres://cs_agent:cs_agent@localhost:5432/cs_agent

# Required: Fernet key for API Key encryption. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Used from Phase 4 (RAG)
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.6
